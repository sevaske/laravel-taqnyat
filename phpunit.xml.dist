<?xml version="1.0" encoding="UTF-8"?>
<!-- Kept schema-free on purpose: it must work with PHPUnit 9 (Laravel 8) through PHPUnit 13 (Laravel 13). -->
<phpunit bootstrap="vendor/autoload.php" colors="true">
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
